<h1>Welcome to the Online Marketplace!</h1>

<% if logged_in? %>
  <p>Hello, <%= current_user.name || current_user.email %>!</p>
  <%= link_to "Logout", logout_path, method: :delete %>
<% else %>
  <%= link_to "Login", login_path %> |
  <%= link_to "Sign Up", signup_path %>
<% end %>

<hr>

<h2>Shops</h2>
<%= link_to "Browse Shops", shops_path %>

<h2>Products</h2>
<%= link_to "Browse Products", products_path %>

