<%= form_with(model: @review) do |f| %>
  <div>
    <%= f.label :product_id, "Product" %>
    <%= f.collection_select :product_id, Product.all, :id, :name, prompt: "Select Product" %>
  </div>

  <div>
    <%= f.label :user_id, "User" %>
    <%= f.collection_select :user_id, User.all, :id, :name, prompt: "Select User" %>
  </div>

  <div>
    <%= f.label :rating %>
    <%= f.number_field :rating, in: 1..5 %>
  </div>

  <div>
    <%= f.label :comment %>
    <%= f.text_area :comment %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
